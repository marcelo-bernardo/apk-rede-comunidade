# Endereço da API. Sem esta variável, em desenvolvimento o app usa
# http://<IP da máquina do Expo>:3333 automaticamente.
# EXPO_PUBLIC_API_URL=https://rede-comunidade-api-yb1n.onrender.com

# Chave Google Maps SDK for Android (restrita ao pacote
# com.afavorita.redecomunidade + SHA-1 do keystore). Sem ela o mapa sai
# em branco no APK — no Expo Go funciona sem.
# GOOGLE_MAPS_API_KEY=
