{
  "expo": {
    "name": "Rede Comunidade",
    "slug": "rede-comunidade",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.afavorita.redecomunidade"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ecfdf5"
      },
      "package": "com.afavorita.redecomunidade"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ecfdf5"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Rede Comunidade usa sua localização para posicionar você no mapa e registrar rotas e alertas do seu entorno."
        }
      ]
    ],
    "scheme": "rede-comunidade"
  }
}
